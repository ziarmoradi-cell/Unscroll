	<string>Unscroll zählt deine Schritte, um dir Zeitguthaben gutzuschreiben.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UnscrollAppGroup</key>
	<string>$(UNSCROLL_APP_GROUP)</string>
